# Leave blank to run in offline/mock mode (fake pay page, rule-based agent)
SARVAM_API_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional when Payouts or Secure ID use a different Cashfree app/key pair.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_VERIFY_CLIENT_ID=
CASHFREE_VERIFY_CLIENT_SECRET=
CASHFREE_BASE=https://sandbox.cashfree.com
# public https URL (ngrok) for Cashfree payment, payout, and subscription webhooks
PUBLIC_URL=http://localhost:8000
PAYOUT_PIN=1234
DAILY_PAYOUT_LIMIT=5000
# SARVAM_LLM_MODEL=sarvam-105b  SARVAM_STT_MODEL=saaras:v3  SARVAM_TTS_MODEL=bulbul:v3  SARVAM_SPEAKER=shubh

# --- Owner WhatsApp voice agent (Meta WhatsApp Cloud API) ---
OWNER_PHONE=9800000000          # owner's WhatsApp number; anyone else is ignored
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=kiraya    # webhook URL: PUBLIC_URL/webhooks/whatsapp
WHATSAPP_APP_SECRET=            # verifies X-Hub-Signature-256
# WA_AUDIO_CODEC=mp3

# --- Reminder phone calls to tenants (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=                    # your Twilio number, e.g. +1...

# Approved WhatsApp template used to message a tenant who has not messaged us in 24h. Body vars: {{1}} name {{2}} amount {{3}} link
WA_LINK_TEMPLATE=
WA_TEMPLATE_LANG=en

# --- Sarvam Voice Agents (Samvaad): reminder + complaint calls (preferred over Twilio when all are set) ---
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=            # the collection agent's ID
SARVAM_VOICE_APP_VERSION=1      # committed version number
SARVAM_VOICE_CONNECTION_ID=     # the rented phone number's connection ID
SARVAM_VOICE_NUMBER=            # that number, e.g. +918064261195

# onboarding / move-out / receipts
PROPERTY_ADDRESS=
SARVAM_ONBOARD_APP_ID=
SARVAM_ONBOARD_APP_VERSION=
DEPOSIT_PAYOUT_LIMIT=
WA_ONBOARD_TEMPLATE=
WA_RECEIPT_TEMPLATE=
WA_SETTLE_TEMPLATE=
CASHFREE_PAYOUT_BASE=https://payout-gamma.cashfree.com
SARVAM_OWNER_APP_ID=            # dedicated realtime agent for calls with the owner
SARVAM_OWNER_APP_VERSION=1
SARVAM_VOICE_TOOL_SECRET=       # random value also sent as X-Voice-Key by the agent's HTTP tools
